// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLATFORM_ADMIN
  ORG_ADMIN
  ORG_MEMBER
}

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum IssueStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
}

enum ResourceType {
  PROJECTS
  TASKS
  USERS
  STORAGE_BYTES
}

enum AttachmentStatus {
  RESERVED
  COMMITTED
  EXPIRED
}

/// Global catalog of plan tiers — not tenant-scoped, shared across organisations.
model SubscriptionPlan {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  max_users      Int
  max_projects   Int
  max_tasks      Int
  max_storage_mb Int
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  organisations Organisation[]
}

/// Tenant workspace. Root of the tenant hierarchy — every content model
/// traces back to one via organisation_id.
model Organisation {
  id         String             @id @default(uuid()) @db.Uuid
  name       String
  slug       String             @unique
  status     OrganisationStatus @default(ACTIVE)
  plan_id    String             @db.Uuid
  plan       SubscriptionPlan   @relation(fields: [plan_id], references: [id])
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  users           User[]
  projects        Project[]
  issues          Issue[]
  usage_counters  UsageCounter[]
  attachments     Attachment[]
  project_members ProjectMember[]
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  organisation_id String       @db.Uuid
  organisation    Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  email           String       @unique
  password_hash   String
  first_name      String
  last_name       String
  role            Role         @default(ORG_MEMBER)
  status          UserStatus   @default(ACTIVE)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  assigned_issues     Issue[]
  project_memberships ProjectMember[]

  @@unique([organisation_id, id])
  @@index([organisation_id])
}

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  organisation_id String        @db.Uuid
  organisation    Organisation  @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  name            String
  description     String?
  status          ProjectStatus @default(ACTIVE)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  issues  Issue[]
  members ProjectMember[]

  @@unique([organisation_id, id])
  @@index([organisation_id])
}

/// Which users may see and work in a project. Tenant isolation (RLS) keeps
/// orgs apart; this table separates users *within* an org: an ORG_MEMBER
/// only sees projects they have a row here for (ORG_ADMINs see them all).
/// Both composite FKs lead with organisation_id, so a membership can never
/// join a project to a user from another tenant — Postgres rejects the row.
model ProjectMember {
  id              String       @id @default(uuid()) @db.Uuid
  organisation_id String       @db.Uuid
  organisation    Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  project_id      String       @db.Uuid
  project         Project      @relation(fields: [organisation_id, project_id], references: [organisation_id, id], onDelete: Cascade)
  user_id         String       @db.Uuid
  user            User         @relation(fields: [organisation_id, user_id], references: [organisation_id, id], onDelete: Cascade)
  created_at      DateTime     @default(now())

  @@unique([project_id, user_id])
  @@unique([organisation_id, id])
  @@index([organisation_id, user_id])
}

model Issue {
  id              String        @id @default(uuid()) @db.Uuid
  organisation_id String        @db.Uuid
  organisation    Organisation  @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  project_id      String        @db.Uuid
  project         Project       @relation(fields: [organisation_id, project_id], references: [organisation_id, id], onDelete: Cascade)
  title           String
  description     String?
  status          IssueStatus   @default(TODO)
  priority        IssuePriority @default(MEDIUM)
  /// Nullable: an unassigned issue. The composite FK keeps an assignee in
  /// the same org as the issue. No ON DELETE SET NULL — Postgres would null
  /// organisation_id too (it is part of the same FK), and Prisma cannot
  /// express the column-list form — so every path that removes or
  /// deactivates a user clears their assignments explicitly first.
  assignee_id     String?       @db.Uuid
  assignee        User?         @relation(fields: [organisation_id, assignee_id], references: [organisation_id, id], onDelete: NoAction)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  attachments Attachment[]

  @@unique([organisation_id, id])
  @@index([organisation_id, project_id])
  @@index([organisation_id, assignee_id])
}

/// Per-tenant, per-resource quota tracker. Enforces plan limits atomically at
/// the DB layer: a single conditional UPDATE (see src/lib/usageCounters.ts)
/// increments `value` only if the result would stay within `max_limit`, so
/// concurrent requests racing for the last slot are serialized by Postgres's
/// row lock on that single row — exactly one wins, no count-then-create gap.
/// value/max_limit are BigInt (not Int) because STORAGE_BYTES counts raw
/// bytes: a Professional-tier plan's 10GB limit (10,737,418,240 bytes)
/// already overflows Postgres's int4/Prisma's Int (max ~2.147B).
model UsageCounter {
  id              String       @id @default(uuid()) @db.Uuid
  organisation_id String       @db.Uuid
  organisation    Organisation @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  resource_type   ResourceType
  value           BigInt       @default(0)
  max_limit       BigInt
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  @@unique([organisation_id, resource_type])
  @@index([organisation_id])
}

/// Metadata row for a file uploaded to SeaweedFS's S3-compatible object
/// store. The upload itself is a direct-to-storage flow (client PUTs bytes
/// straight to a presigned URL — the app never proxies file bytes):
/// RESERVED is created by /attachments/reserve (claims storage quota and
/// hands back a presigned PUT URL), then /attachments/:id/commit verifies
/// the object actually landed (server-side HeadObject) and flips it to
/// COMMITTED. A RESERVED row whose reservation TTL (expires_at) lapses
/// without a commit is swept to EXPIRED and its claimed bytes released —
/// see src/services/attachmentService.ts.
model Attachment {
  id              String           @id @default(uuid()) @db.Uuid
  organisation_id String           @db.Uuid
  organisation    Organisation     @relation(fields: [organisation_id], references: [id], onDelete: Cascade)
  issue_id        String           @db.Uuid
  issue           Issue            @relation(fields: [organisation_id, issue_id], references: [organisation_id, id], onDelete: Cascade)
  uploaded_by     String           @db.Uuid
  file_name       String
  content_type    String
  size_bytes      BigInt
  storage_key     String           @unique
  status          AttachmentStatus @default(RESERVED)
  expires_at      DateTime?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  @@unique([organisation_id, id])
  @@index([organisation_id, issue_id])
  @@index([status, expires_at])
}
