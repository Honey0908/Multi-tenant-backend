PORT=3000

DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public"

# Non-superuser role — the running app connects as this so RLS is actually
# enforced (superusers bypass RLS unconditionally; see the create_app_role
# migration). Only DATABASE_URL (above) is used by `prisma migrate`.
APP_DATABASE_URL="postgresql://app_user:app_user@localhost:5432/taskflow?schema=public"

S3_ENDPOINT="http://localhost:8333"
S3_ACCESS_KEY_ID="taskflow"
S3_SECRET_ACCESS_KEY="taskflow-secret"
S3_BUCKET="taskflow-attachments"
# The AWS SDK requires a region even for a non-AWS S3-compatible endpoint;
# SeaweedFS ignores its value.
S3_REGION="us-east-1"

# How long a reserved (not yet uploaded) attachment holds its storage-quota
# claim before it's treated as abandoned and released — see
# src/services/attachmentService.ts.
ATTACHMENT_RESERVATION_TTL_MINUTES="15"
# Hard per-file cap, independent of plan storage headroom — bounds a single
# upload regardless of how much quota an org has left.
ATTACHMENT_MAX_FILE_SIZE_MB="200"

# Narrow, BYPASSRLS-but-SELECT-only-on-User role used exclusively by the
# login lookup (finding a user by email, before we know their orgId).
# Never used for any other query — see create_auth_reader_role migration.
AUTH_DATABASE_URL="postgresql://auth_reader:auth_reader@localhost:5432/taskflow?schema=public"

# Read-only role (SELECT on Organisation/SubscriptionPlan/User only) used
# exclusively by the platform-admin routes — see create_platform_reader_role
# migration. Never used for any tenant-facing route.
PLATFORM_DATABASE_URL="postgresql://platform_reader:platform_reader@localhost:5432/taskflow?schema=public"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1h"
